            "os.rmdir(\"renamed_folder\")\n",
            "\n",
            "\n",
            "--- Cell 2 ---\n",
            "from datetime import datetime, date, timedelta\n",
            "\n",
            "# Current date and time\n",
            "now = datetime.now()\n",
            "print(\"Now:\", now)\n",
            "\n",
            "# Only today's date\n",
            "today = date.today()\n",
            "print(\"Today's Date:\", today)\n",
