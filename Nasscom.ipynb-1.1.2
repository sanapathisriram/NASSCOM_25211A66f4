      "source": [
        "import random\n",
        "import datetime\n",
        "\n",
        "DEVICE_TYPES = ['Temperature_Sensor', 'Humidity_Sensor', 'Pressure_Sensor', 'Light_Sensor']\n",
        "LOCATIONS = ['Lab1', 'Lab2', 'OfficeA', 'OfficeB', 'Warehouse']\n",
        "READING_RANGES = {\n",
        "    'Temperature_Sensor': (10, 30),\n",
        "    'Humidity_Sensor': (30, 80),\n",
        "    'Pressure_Sensor': (980, 1080),\n",
        "    'Light_Sensor': (100, 1000)\n",
        "}\n",
        "\n",
        "def generate_sensor_data(device_id):\n",
        "    device_type = random.choice(DEVICE_TYPES)\n",
        "    location = random.choice(LOCATIONS)\n",
        "    min_val, max_val = READING_RANGES[device_type]\n",
        "    reading = round(random.uniform(min_val, max_val), 2)\n",
        "    timestamp = datetime.datetime.now() - datetime.timedelta(minutes=random.randint(0, 1440))\n",
        "\n",
        "    return {\n",
        "        'device_id': device_id,\n",
        "        'device_type': device_type,\n",
        "        'location': location,\n",
        "        'reading': reading,\n",
        "        'timestamp': timestamp.strftime('%Y-%m-%d %H:%M:%S')\n",
        "    }\n",
        "\n",
        "# Generate and display 5 sample sensor readings\n",
        "sample_readings = [generate_sensor_data(f'DEV_{100 + i}') for i in range(5)]\n",
        "for reading in sample_readings:\n",
        "    print(reading)"
      ],
