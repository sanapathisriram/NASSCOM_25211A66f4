        "import json\n",
        "\n",
        "notebook_path = '/content/1.1.2Working_with_Core_Python_Libraries_OS_,_datetime_,_random_.ipynb'\n",
        "with open(notebook_path, 'r', encoding='utf-8') as f:\n",
        "    nb_data = json.load(f)\n",
        "\n",
        "# Filter and print Python code cells from the file to inspect them\n",
        "code_cells = [cell for cell in nb_data.get('cells', []) if cell.get('cell_type') == 'code']\n",
        "print(f'Total code cells found: {len(code_cells)}')\n",
        "for i, cell in enumerate(code_cells):\n",
        "    print(f'\\n--- Cell {i+1} ---')\n",
        "    print(''.join(cell.get('source', [])))"
